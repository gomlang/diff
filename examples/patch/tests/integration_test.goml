package tests;

use ecosystem::diff;
use ecosystem::proptest;
use std::testing;

#[test]
fn linear_algorithm_patch_and_generic_callback_cross_dependency_boundary() -> () {
    let old = Vec::from_array(["a", "b", "c"]);
    let new = Vec::from_array(["B", "D"]);
    let operations = testing::expect_ok(
        diff::sequence_with(
            old.as_slice(),
            new.as_slice(),
            |left, right| left.eq_ignore_ascii_case(right),
            diff::Options::new(),
            diff::Algorithm::Hirschberg,
        ),
        "linear sequence",
    );
    testing::assert_eq(diff::distance(operations), 3);
    let patch = testing::expect_ok(
        diff::patch_with(
            "a\nb\n",
            "b\nc",
            "old",
            "new",
            3,
            diff::Options::new(),
            diff::Algorithm::Hirschberg,
        ),
        "linear patch",
    );
    testing::assert_eq(testing::expect_ok(patch.apply("a\nb\n"), "apply"), "b\nc");
}

#[test]
fn randomized_patch_roundtrips() -> () {
    let alphabet = testing::expect_ok(
        proptest::select(Vec::from_array(['a', 'b', '\n', '\r', '你', '😀'])),
        "alphabet",
    );
    let strings = testing::expect_ok(proptest::strings(alphabet, 0, 50), "strings");
    let pairs = strings.zip(strings);
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                pairs,
                proptest::Config::new(77),
                |pair: (string, string)| {
                    let patch = match diff::patch(pair.0, pair.1, "old", "new", 2) {
                        Ok(value) => value,
                        Err(_) => return false,
                    };
                    if patch.apply(pair.0).unwrap_or("wrong") != pair.1 {
                        return false
                    }
                    if patch.reverse().apply(pair.1).unwrap_or("wrong") != pair.0 {
                        return false
                    }
                    let text = match patch.to_unified() {
                        Ok(value) => value,
                        Err(_) => return false,
                    };
                    match diff::parse_unified(text) {
                        Ok(value) => value.apply(pair.0).unwrap_or("wrong") == pair.1,
                        Err(_) => false,
                    }
                },
            ),
            "patch property",
        ),
    );
}

#[test]
fn downstream_sparse_patch_preserves_large_context() -> () {
    let middle = "unchanged\n".repeat(10000);
    let old = "before\n" + middle + "after\n";
    let new = "BEFORE\n" + middle + "AFTER\n";
    let patch = testing::expect_ok(diff::patch(old, new, "old", "new", 2), "sparse patch");
    testing::assert_eq(patch.hunks.len(), 2);
    testing::assert_eq(testing::expect_ok(patch.apply(old), "apply"), new);
    testing::assert_eq(testing::expect_ok(patch.reverse().apply(new), "reverse"), old);
}

#[test]
fn downstream_comparators_do_not_run_after_search_budget_exhaustion() -> () {
    let values = Vec::from_array(["a"]);
    let calls = Ref::new(0);
    testing::assert_err(
        diff::sequence_by(
            values.as_slice(),
            values.as_slice(),
            |left, right| {
                calls.set(calls.get() + 1);
                left == right
            },
            diff::Options { max_work: 2, max_trace: 100 },
        ),
    );
    testing::assert_eq(calls.get(), 0);
}
