package diff;

#[derive(Debug, PartialEq)]
pub enum Tag {
    Equal,
    Delete,
    Insert,
}

#[derive(Debug, PartialEq)]
pub struct Op {
    pub tag: Tag,
    pub old_start: isize,
    pub old_end: isize,
    pub new_start: isize,
    pub new_end: isize,
}

pub struct Options {
    pub max_work: isize,
    pub max_trace: isize,
}

impl Options {
    pub fn new() -> Options {
        Options { max_work: 10000000, max_trace: 1000000 }
    }
}

fn diagonal(row: Vec[isize], k: isize) -> isize {
    row[k + (row.len() - 1) / 2]
}

fn push_reverse(operations: Vec[Op], operation: Op) -> () {
    if operation.old_start == operation.old_end && operation.new_start == operation.new_end {
        return
    }
    if let Some(previous) = operations.last() {
        if previous.tag == operation.tag {
            operations[operations.len() - 1] = Op {
                old_start: operation.old_start,
                new_start: operation.new_start,
                ..previous,
            };
            return
        }
    }
    operations.push(operation);
}

fn backtrack(trace: Vec[Vec[isize]], old_len: isize, new_len: isize) -> Vec[Op] {
    let result: Vec[Op] = Vec::new();
    let mut x = old_len;
    let mut y = new_len;
    let mut d = trace.len() - 1;
    while d > 0 {
        let k = x - y;
        let previous = trace[d - 1];
        let previous_k: isize = if k == -d
            || (k != d && diagonal(previous, k - 1) < diagonal(previous, k + 1)) {
            k + 1
        } else {
            k - 1
        };
        let previous_x = diagonal(previous, previous_k);
        let previous_y = previous_x - previous_k;
        let count = if x - previous_x < y - previous_y {
            x - previous_x
        } else {
            y - previous_y
        };
        push_reverse(
            result,
            Op {
                tag: Tag::Equal,
                old_start: x - count,
                old_end: x,
                new_start: y - count,
                new_end: y,
            },
        );
        x -= count;
        y -= count;
        if x == previous_x {
            push_reverse(
                result,
                Op { tag: Tag::Insert, old_start: x, old_end: x, new_start: y - 1, new_end: y },
            );
            y -= 1;
        } else {
            push_reverse(
                result,
                Op { tag: Tag::Delete, old_start: x - 1, old_end: x, new_start: y, new_end: y },
            );
            x -= 1;
        }
        d -= 1;
    }
    let count = if x < y {
        x
    } else {
        y
    };
    push_reverse(
        result,
        Op { tag: Tag::Equal, old_start: x - count, old_end: x, new_start: y - count, new_end: y },
    );
    x -= count;
    y -= count;
    push_reverse(
        result,
        Op { tag: Tag::Delete, old_start: 0, old_end: x, new_start: y, new_end: y },
    );
    push_reverse(
        result,
        Op { tag: Tag::Insert, old_start: 0, old_end: 0, new_start: 0, new_end: y },
    );
    result.reverse();
    result
}

pub fn sequence_by[T](old: Slice[T], new: Slice[T], equal: (T, T) -> bool, options: Options) -> Result[
    Vec[Op],
    string,
] {
    if options.max_work < 1 || options.max_trace < 1 {
        return Result::Err("diff budgets must be positive")
    }
    if old.len() == 0 && new.len() == 0 {
        return Result::Ok(Vec::new())
    }
    if old.len() == 0 {
        return Result::Ok(
            Vec::from_array(
                [
                    Op {
                        tag: Tag::Insert,
                        old_start: 0,
                        old_end: 0,
                        new_start: 0,
                        new_end: new.len(),
                    },
                ],
            ),
        )
    }
    if new.len() == 0 {
        return Result::Ok(
            Vec::from_array(
                [
                    Op {
                        tag: Tag::Delete,
                        old_start: 0,
                        old_end: old.len(),
                        new_start: 0,
                        new_end: 0,
                    },
                ],
            ),
        )
    }
    let trace: Vec[Vec[isize]] = Vec::new();
    let mut work = 0;
    let mut cells = 0;
    let mut d = 0;
    loop {
        let width = 2 * d + 1;
        if width > options.max_trace - cells {
            return Result::Err("diff trace budget exceeded")
        }
        cells += width;
        let row: Vec[isize] = Vec::with_capacity(width);
        for _ in 0..width {
            row.push(0);
        }
        let mut k = -d;
        while k <= d {
            work += 1;
            if work > options.max_work {
                return Result::Err("diff work budget exceeded")
            }
            let mut x: isize = if d == 0 {
                0
            } else {
                let previous = trace[d - 1];
                if k == -d || (k != d && diagonal(previous, k - 1) < diagonal(previous, k + 1)) {
                    diagonal(previous, k + 1)
                } else {
                    diagonal(previous, k - 1) + 1
                }
            };
            let mut y = x - k;
            while x < old.len() && y < new.len() && equal(old[x], new[y]) {
                x += 1;
                y += 1;
                work += 1;
                if work > options.max_work {
                    return Result::Err("diff work budget exceeded")
                }
            }
            row[k + d] = x;
            if x >= old.len() && y >= new.len() {
                trace.push(row);
                return Result::Ok(backtrack(trace, old.len(), new.len()))
            }
            k += 2;
        }
        trace.push(row);
        d += 1;
    }
}

pub fn sequence[T: PartialEq](old: Slice[T], new: Slice[T]) -> Result[Vec[Op], string] {
    sequence_by(old, new, |left, right| left == right, Options::new())
}

pub fn distance(operations: Vec[Op]) -> isize {
    let mut result = 0;
    for operation in operations {
        if operation.tag == Tag::Delete {
            result += operation.old_end - operation.old_start;
        }
        if operation.tag == Tag::Insert {
            result += operation.new_end - operation.new_start;
        }
    }
    result
}

pub fn invert(operations: Vec[Op]) -> Vec[Op] {
    let result: Vec[Op] = Vec::new();
    for operation in operations {
        let tag = match operation.tag {
            Equal => Tag::Equal,
            Insert => Tag::Delete,
            Delete => Tag::Insert,
        };
        result.push(
            Op {
                tag,
                old_start: operation.new_start,
                old_end: operation.new_end,
                new_start: operation.old_start,
                new_end: operation.old_end,
            },
        );
    }
    result
}
